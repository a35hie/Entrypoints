{
  "name": "@a35hie/entrypoints",
  "version": "0.2.3",
  "type": "module",
  "description": "Generate self-contained HTML entrypoint pages from a template and typed config.",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": "https://github.com/a35hie/Entrypoints",
  "bin": {
    "entrypoints": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src/entrypoints-template"
  ],
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly --declaration --declarationDir dist --noEmit false",
    "create": "bun run src/cli.ts create",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write --experimental-cli --ignore-path .prettierignore ."
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/html-minifier-terser": "^7.0.2",
    "@types/node": "^26.6.5",
    "prettier": "^3.9.10",
    "typescript": "^7.0.0"
  },
  "dependencies": {
    "html-minifier-terser": "^7.2.0",
    "sass": "^1.89.0",
    "vite": "^8.3.5"
  }
}
